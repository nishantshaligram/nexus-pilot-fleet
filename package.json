{
  "name": "nexus-pilot-fleet",
  "version": "1.0.0",
  "description": "Distributed Multi-Agent Swarm Orchestrator, Git Worktree Multiplexer & DAG Pipeline Engine for AI Coding Agents",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "nexus-pilot-fleet": "./bin/nexus-pilot-fleet.js"
  },
  "files": [
    "bin",
    "src",
    "server",
    "rules",
    "skills",
    "assets",
    "plugin.json",
    "mcp_config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/nexus-pilot-fleet.js",
    "serve": "node ./bin/nexus-pilot-fleet.js serve",
    "install:agents": "node ./bin/nexus-pilot-fleet.js install",
    "doctor": "node ./bin/nexus-pilot-fleet.js doctor",
    "test": "python tests/run_tests.py",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "homepage": "https://nishantshaligram.github.io/nexus-pilot-fleet/",
  "devDependencies": {
    "vitepress": "^1.5.0"
  },
  "keywords": [
    "ai-agent",
    "multi-agent",
    "swarm",
    "swarm-orchestrator",
    "mcp",
    "model-context-protocol",
    "git-worktree",
    "dag-scheduler",
    "antigravity",
    "claude-code",
    "cursor",
    "windsurf"
  ],
  "author": "Nishant Shaligram <nishant.shaligram@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nishantshaligram/nexus-pilot-fleet.git"
  },
  "bugs": {
    "url": "https://github.com/nishantshaligram/nexus-pilot-fleet/issues"
  }
}
